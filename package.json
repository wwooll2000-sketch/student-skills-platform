{
  "name": "student-skills-platform",
  "version": "1.0.0",
  "description": "نظام متابعة مهارات الطلاب - لغة عربية",
  "main": "api/index.js",
  "type": "module",
  "scripts": {
    "dev": "node api/index.js",
    "start": "node api/index.js",
    "build": "echo 'Build successful'",
    "test": "echo 'Test successful'",
    "setup": "node api/setup-db.js",
    "seed": "SEED_DB=true node api/seed.js",
    "export": "node api/migrate.js export",
    "import": "node api/migrate.js import",
    "db:clear": "node -e \"import('./api/db.js').then(m => { import('./api/seed.js').then(s => s.clearDatabase()); })\"",
    "db:stats": "node -e \"import('./api/seed.js').then(s => s.getDatabaseStats().then(x => console.log(JSON.stringify(x, null, 2))))\""
  },
  "keywords": [
    "students",
    "skills",
    "platform",
    "arabic"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "express": "^4.18.2",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "pg": "^8.11.2",
    "uuid": "^9.0.0",
    "bcryptjs": "^2.4.3",
    "jsonwebtoken": "^9.1.0"
  },
  "devDependencies": {
    "nodemon": "^3.0.1"
  },
  "engines": {
    "node": "18.x"
  }
}
